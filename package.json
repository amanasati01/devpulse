{
  "name": "devpulse",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "build:ci": "pnpm turbo run build --force",
    "start": "pnpm --filter @devpulse/web start",
    "worker": "pnpm --filter @devpulse/worker dev",
    "ws": "pnpm --filter @devpulse/ws dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @devpulse/db prisma:generate",
    "db:migrate": "pnpm --filter @devpulse/db prisma:migrate",
    "db:seed": "pnpm --filter @devpulse/db prisma:seed"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
