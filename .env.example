# DevPulse Environment Configuration
# Copy this file to .env and fill in the values

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Redis (Upstash or local)
# Must use rediss:// for Upstash (TLS enabled)
REDIS_URL="rediss://default:password@host:port"

# Upstash REST API (Used for Edge rate limiting in middleware)
UPSTASH_REDIS_REST_URL="https://your-upstash-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Authentication (NextAuth / Auth.js)
# Generate a secret using: openssl rand -base64 32
AUTH_SECRET="your-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth Apps
# Create an OAuth app at GitHub -> Settings -> Developer Settings
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# GitHub Webhooks
# Generate a secret and use the same in your GitHub Repo Webhook settings
GITHUB_WEBHOOK_SECRET="your-webhook-secret"

# AI Integration
OPENAI_API_KEY="sk-your-openai-api-key"

# Internal URLs
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
