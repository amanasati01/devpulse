{
  "name": "@devpulse/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3000",
    "build": "sh -c 'if [ -f ../../.env ]; then dotenv -e ../../.env -- next build; else next build; fi'",
    "start": "sh -c 'if [ -f ../../.env ]; then dotenv -e ../../.env -- next start -p ${PORT:-3000}; else next start -p ${PORT:-3000}; fi'",
    "lint": "next lint"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.6",
    "@devpulse/db": "workspace:*",
    "@devpulse/lib": "workspace:*",
    "@radix-ui/react-slot": "^1.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "next": "14.2.16",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
